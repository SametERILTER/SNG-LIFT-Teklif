{
  "expo": {
    "name": "SNG Lift Teklif",
    "slug": "excelTeklif",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splashScreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#107c41"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon2.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/splashScreen.png",
        "resizeMode": "contain",
        "backgroundColor": "#107c41"
      },
      "package": "com.samet603460.excelTeklif"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "hidden": false,
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#107c41",
          "image": "./assets/splashScreen.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark",
        "hidden": false
      },
      "eas": {
        "projectId": "d7aad220-1b85-4c9f-8368-01fd3ee22799"
      }
    }
  }
}
